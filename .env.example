# API Key de Google AI Studio (gratuita)
# Conseguila en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_aqui
AI_PROVIDER_ORDER=groq,gemini,openrouter,nvidia
NVIDIA_API_KEY=
# Modelos sugeridos desde NVIDIA Build / NIM
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_FALLBACK_MODEL=qwen/qwen3-32b
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
GROQ_API_KEY=
# Modelos sugeridos de Groq
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
# full prioriza calidad del Oraculo al cargar content completo de knowledge_documents.
# Usa summary solo en emergencia si necesitas bajar egress temporalmente.
KNOWLEDGE_CONTENT_MODE=full

# Tu proyecto Supabase
SUPABASE_URL=https://sibisgiwmgdrpfkzmkkw.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key

# Supabase dedicado para el estado operativo del bot
# Si no se define, el bot sigue usando el proyecto principal como fallback.
BOT_SUPABASE_URL=
BOT_SUPABASE_SERVICE_KEY=

# Persistencia recomendada para el runtime vivo en Ubuntu/Docker Compose.
# docker-compose.yml monta ./wwebjs_auth en /app/.wwebjs_auth; no versionar ni borrar esa carpeta.
PERSISTENT_ROOT_PATH=/app
PERSISTENT_DATA_PATH=/app/.wwebjs_auth
WHATSAPP_AUTH_STRATEGY=local

# RemoteAuth queda solo como respaldo historico para entornos con filesystem efimero.
WHATSAPP_REMOTE_AUTH_CACHE_PATH=/tmp/kingdoom-bot-wwebjs-auth
WHATSAPP_REMOTE_AUTH_STORE_PATH=/app/.wwebjs_auth/remote-auth
WHATSAPP_REMOTE_AUTH_BACKUP_INTERVAL_MS=300000
WHATSAPP_REMOTE_AUTH_BACKUP_TIMEOUT_MS=30000
WHATSAPP_REMOTE_AUTH_KEEP_SNAPSHOTS=3

# Panel de estado y recuperacion del cliente de WhatsApp
# /status.json expone el ultimo evento, la estrategia y el estado del snapshot.
WHATSAPP_CONNECT_STALL_TIMEOUT_MS=150000
# ready solo abre una ventana de verificacion; no habilita envios por si mismo.
# Tres fallos funcionales consecutivos evitan recuperaciones por una lectura transitoria.
WHATSAPP_READY_HEALTH_FAILURE_LIMIT=3
WHATSAPP_READY_HEALTH_TIMEOUT_MS=10000
WHATSAPP_HEALTH_STABILITY_MS=60000
WHATSAPP_BRIDGE_EVENT_TIMEOUT_MS=10000
# Mantiene presencia y hace una consulta invisible al servidor cada 2 minutos.
WHATSAPP_ACTIVE_PRESENCE_PROBE=true
WHATSAPP_ACTIVE_NETWORK_PROBE_INTERVAL_MS=120000
# OPENING, PAIRING y TIMEOUT son transitorios; se espera antes de reiniciar Chromium.
WHATSAPP_TRANSIENT_STATE_GRACE_MS=180000
# Recuperacion: reenganchar listeners, reiniciar conservando auth y borrar auth solo ante invalidacion explicita.
WHATSAPP_HEALTH_RECOVERY_WINDOW_MS=3600000
WHATSAPP_HEALTH_RECOVERY_RESET_MS=600000
WHATSAPP_HEALTH_REATTACH_TIMEOUT_MS=60000
WHATSAPP_DELIVERY_ACK_TIMEOUT_MS=20000
WHATSAPP_RESTART_GRACE_MS=2500
WHATSAPP_RECONNECT_MAX_DELAY_MS=60000
WHATSAPP_SHUTDOWN_TIMEOUT_MS=8000
WHATSAPP_TAKEOVER_ON_CONFLICT=true
WHATSAPP_TAKEOVER_TIMEOUT_MS=10000

# Respaldo opcional: vinculacion por numero telefonico en vez de QR.
# Usa el numero completo sin + ni espacios, por ejemplo 595991234567.
WHATSAPP_PAIR_PHONE_NUMBER=
WHATSAPP_PAIR_SHOW_NOTIFICATION=true
WHATSAPP_PAIR_INTERVAL_MS=180000

# Reset manual: dejar en false por defecto para no exponerlo en publico.
# Si se habilita, se requiere token via ?token=... o header x-reset-token.
RESET_AUTH_ENABLED=false
RESET_AUTH_TOKEN=
RUNTIME_STATUS_PATH=

# Tu número de WhatsApp admin (código de país sin +, sin espacios)
# Ejemplo Paraguay: 595991234567@c.us
ADMIN_NUMBER=595991234567@c.us

# Grupo de bienvenida del Heraldo
# Usa el ID exacto del grupo (termina en @g.us) o define el nombre exacto del grupo
WELCOME_GROUP_ENABLED=true
WELCOME_GROUP_ID=
WELCOME_GROUP_NAME=

# Admins a mencionar cuando entre alguien nuevo
# Separados por coma, con o sin @c.us
WELCOME_GROUP_ADMIN_IDS=595991234567

# Texto inicial del grupo. Usa \n para saltos de línea.
WELCOME_GROUP_INTRO=Bienvenido al Reino de Kingdoom. Lee con atencion las indicaciones iniciales y presentate al consejo.

# Links o pasos iniciales. Usa \n para varias lineas.
WELCOME_GROUP_LINKS=• Web del reino: https://xxxraiconxxx.github.io/Kingdoom/\n• Ficha y reglamento: pega aqui tu enlace\n• Grupo de rol: pega aqui tu enlace
